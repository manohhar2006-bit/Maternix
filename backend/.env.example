# ==============================================================================
# Maternix Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Application Secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:3000

# Security & Mock Controls
ENABLE_MOCK_FALLBACK=false

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
