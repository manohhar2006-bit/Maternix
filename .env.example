# ==============================================================================
# Maternix Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Application Secrets
# Generate a strong 32+ character random secret (e.g., `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Amazon RDS / PostgreSQL Database Configuration
# Provide either individual connection parameters or a full DATABASE_URL.
DB_HOST=your-rds-endpoint.cluster-custom.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=maternix
DB_USER=maternix_app
DB_PASSWORD=replace_with_secure_database_password

# Connection Pool & SSL Tuning
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Set DB_SSL=true for Amazon RDS; set DB_SSL_REJECT_UNAUTHORIZED=false if using AWS default certificate without custom trust store
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Alternative: PostgreSQL Connection String URI
# DATABASE_URL=postgresql://maternix_app:password@your-rds-endpoint:5432/maternix?sslmode=require

# CORS Configuration
# Leave blank for same-origin deployment, or specify allowed origin for decoupled frontend
FRONTEND_ORIGIN=http://localhost:3000

# Security & Mock Controls
# CRITICAL: ENABLE_MOCK_FALLBACK MUST be false in production environments.
# Only set to true for isolated local development/demonstrations when DB is unreachable.
ENABLE_MOCK_FALLBACK=false

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
